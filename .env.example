# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg://airtel_mock:%40Airtel_mock2026@localhost:5432/airtel_mock

# Identifiants OAuth2 que la banque utilise pour obtenir un token auprès du mock
CLIENT_ID=b03abf8f-a9cb-47a2-a4a8-b5794d44dd56
CLIENT_SECRET=af62b80a-3ca4-432a-b58b-915ef3903680
TOKEN_TTL_SECONDS=180

# Plateforme de la banque (appels sortants du mock)
# Valeurs ci-dessous : bank-mock local (./start_bank.sh). Chemins provisoires, à remplacer par ceux de la banque.
BANK_BASE_URL=http://localhost:9000
BANK_OPT_IN_PATH=/api/v1/opt-in
BANK_CHECK_ELIGIBILITY_PATH=/api/v1/check-eligibility
BANK_APPLY_LOAN_PATH=/api/v1/apply-loan
BANK_CONFIRM_LOAN_PATH=/api/v1/confirm-loan
BANK_CANCEL_LOAN_PATH=/api/v1/cancel-loan
BANK_TIMEOUT_SECONDS=30

# Bank-mock (banque simulée). Tous optionnels, valeurs par défaut ci-dessous.
# Fichier où sont conservés les prêts accordés (survit aux redémarrages)
BANK_MOCK_LOANS_FILE=bank_mock_loans.json
# Durée du scénario lent (MSISDN finissant par 3), à garder au-dessus de BANK_TIMEOUT_SECONDS
BANK_MOCK_SLOW_SECONDS=35
BANK_MOCK_MIN_AMOUNT=5000
BANK_MOCK_MAX_AMOUNT=100000
BANK_MOCK_ELIGIBLE_AMOUNT=50000
BANK_MOCK_INTEREST_RATE=2
BANK_MOCK_TENURE_DAYS=30
